# --- Meta Cloud API ---
# Token de acceso permanente (System User token) generado en Meta Business Suite
WHATSAPP_TOKEN=

# Phone Number ID del numero principal (no es el numero de telefono, es el ID interno de Meta)
PHONE_NUMBER_ID=

# Token que vos elegis (cualquier string secreto) para verificar el webhook con Meta
VERIFY_TOKEN=cambia-este-valor-por-uno-secreto

# Puerto donde corre el servidor local (detras del proxy HTTPS del VPS)
PORT=3000

# --- Numeros de destino por departamento (formato E.164 sin "+", ej: 573001234567) ---
DEPT_CONTABILIDAD=57XXXXXXXXXX
DEPT_PUNTO_DE_VENTA=57XXXXXXXXXX
DEPT_ADMINISTRACION=57XXXXXXXXXX
DEPT_PROGRAMACION_PRODUCCION=57XXXXXXXXXX

# --- Textos personalizables ---
WELCOME_HEADER=Plasticos Superior
WELCOME_BODY=Hola, bienvenido a Plasticos Superior. Por favor elegi el area con la que queres comunicarte:
WELCOME_BUTTON_TEXT=Ver opciones
